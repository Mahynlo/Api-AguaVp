{
  "name": "@aguavp/api-server",
  "version": "1.0.2",
  "description": "Agua VP API Server - Controlable SQLite server with auto-migrations",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/api-module.js",
      "require": "./src/api-module.js"
    }
  },
  "main": "./src/api-module.js",
  "files": [
    "src/",
    "!src/**/*.test.js",
    "!src/test/"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/test/unit",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/test/unit",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test:password": "node src/utils/testPasswordValidator.js",
    "migrate": "node src/database/migrations/runMigration.js",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:triggers": "node src/database/migrations/applyTriggers.js",
    "build": "esbuild src/index.js --bundle --platform=node --outfile=dist/server.cjs --format=cjs"
  },
  "keywords": [],
  "author": "Mahinalo Softwere Solutions",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.27.2",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ws": "^8.18.3"
  }
}
