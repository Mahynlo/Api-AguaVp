# ─────────────────────────────────────────────────────────────
# Variables para desarrollo local (npm run dev / npm start).
# En Electron NO se usa este archivo: AguaVPServer recibe la
# configuración por constructor (ver src/api-module.js).
# ─────────────────────────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos SQLite local (por defecto: src/database/agua-vp-local.db)
# Antes de arrancar por primera vez: npm run migrate
DB_PATH=

# Seguridad (REQUERIDAS)
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=15m
SECRET_APP_KEY=your-app-key-secret
APPKEY_INICIAL=your-initial-app-key

# Modo de ejecución de cron jobs (LOCAL o SERVER)
# LOCAL: ejecuta los jobs al iniciar + cada hora
# SERVER: ejecuta los jobs a las 3:00 AM
EXECUTION_MODE=LOCAL

# Sincronización con Turso Cloud (opcional)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Correo de recuperación de contraseña con Resend (opcional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_PUBLIC_URL=

# Rate limit de registro de apps (opcional)
RATE_LIMIT_REGISTRO_APP_MAX=
